{
  "name": "citylearn-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "hyparquet": "1.32.0",
    "hyparquet-compressors": "1.1.2",
    "lucide-react": "^1.20.0",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests e2e scripts/*.mjs *.config.js --max-warnings=0 && node scripts/check-architecture.mjs",
    "format:check": "prettier --check src scripts/*.mjs e2e *.config.js package.json .prettierrc.json .github/workflows/*.yml",
    "format": "prettier --write src scripts/*.mjs e2e *.config.js package.json .prettierrc.json .github/workflows/*.yml",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm run test:browser"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
